# Telegram credentials (required)
TELEGRAM_TOKEN=123456:ABCDEF-your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# Chain RPC. Default is BNB Smart Chain. Override for other chains.
RPC_URL=https://bsc-dataseed.bnbchain.org

# Factory contract that emits DistributorCreated.
FACTORY_ADDRESS=0x000310fa98E36191ec79de241d72C6CA093EAfD3

# Polling tuning
POLL_INTERVAL=5
BLOCK_LOOKBACK=20
MAX_BLOCK_RANGE=1000

# Explorer URL prefixes used in Telegram messages
EXPLORER_TX=https://bscscan.com/tx/
EXPLORER_ADDR=https://bscscan.com/address/
EXPLORER_TOKEN=https://bscscan.com/token/

# Where to persist the last processed block
STATE_FILE=.bot_state.json

LOG_LEVEL=INFO
