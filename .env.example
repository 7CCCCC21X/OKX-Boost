# --- Telegram (required) ----------------------------------------------------

# Bot token from @BotFather
TELEGRAM_TOKEN=123456:ABCDEF-your-bot-token

# Where unsolicited DistributorCreated alerts are sent (channel id, group id,
# or your own user id). Negative numbers are channels/groups. Supports a
# single id or a comma-separated list — every id receives the broadcast.
# All chains' alerts are fanned out to the same chat(s); each message is
# labeled with its chain.
TELEGRAM_CHAT_ID=-1001234567890

# Comma-separated Telegram user IDs allowed to interact with the bot.
# Non-listed users are silently ignored. Leave EMPTY to allow everyone (not
# recommended on a public bot). Use /id once whitelisted to discover IDs;
# for the very first user, get your id from @userinfobot.
TELEGRAM_WHITELIST=11111111,22222222

# --- Chains -----------------------------------------------------------------
#
# Comma-separated list of chain keys to monitor in this single bot process.
# Order matters: the first key is used as the default for /preview when no
# chain argument is given, unless DEFAULT_CHAIN overrides it.
#
# For each key K listed in CHAINS, the bot reads K_RPC_URL, K_FACTORY_ADDRESS,
# K_EXPLORER_TX, K_EXPLORER_ADDR, K_EXPLORER_TOKEN, K_DISPLAY_NAME, and
# (optionally) K_RPC_API_KEY. Built-in display name defaults: bsc, eth, arb,
# base, polygon, op.
#
# K_FACTORY_ADDRESS may be a comma-separated list to watch several factory
# contracts (e.g. different deployment versions) on the same chain at once.
#
# If CHAINS is unset, the bot runs in single-chain mode using the legacy
# bare RPC_URL / FACTORY_ADDRESS / EXPLORER_* vars below (treated as `bsc`).
CHAINS=bsc,eth,arb,base
DEFAULT_CHAIN=bsc

# --- Per-chain config -------------------------------------------------------

BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_RPC_API_KEY=
# Comma-separate to watch multiple factories (V1 + V2 deployments) at once.
BSC_FACTORY_ADDRESS=0x000310fa98E36191ec79de241d72C6CA093EAfD3,0x00306cEFc385c8767cA580913a3F88319a343FC0
BSC_EXPLORER_TX=https://bscscan.com/tx/
BSC_EXPLORER_ADDR=https://bscscan.com/address/
BSC_EXPLORER_TOKEN=https://bscscan.com/token/
BSC_DISPLAY_NAME=BSC

ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/{API_KEY}
ETH_RPC_API_KEY=
ETH_FACTORY_ADDRESS=0x000310fa98E36191ec79de241d72C6CA093EAfD3
ETH_EXPLORER_TX=https://etherscan.io/tx/
ETH_EXPLORER_ADDR=https://etherscan.io/address/
ETH_EXPLORER_TOKEN=https://etherscan.io/token/
ETH_DISPLAY_NAME=Ethereum

ARB_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/{API_KEY}
ARB_RPC_API_KEY=
ARB_FACTORY_ADDRESS=0x000310fa98E36191ec79de241d72C6CA093EAfD3
ARB_EXPLORER_TX=https://arbiscan.io/tx/
ARB_EXPLORER_ADDR=https://arbiscan.io/address/
ARB_EXPLORER_TOKEN=https://arbiscan.io/token/
ARB_DISPLAY_NAME=Arbitrum

BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/{API_KEY}
BASE_RPC_API_KEY=
BASE_FACTORY_ADDRESS=0x000310fa98E36191ec79de241d72C6CA093EAfD3
BASE_EXPLORER_TX=https://basescan.org/tx/
BASE_EXPLORER_ADDR=https://basescan.org/address/
BASE_EXPLORER_TOKEN=https://basescan.org/token/
BASE_DISPLAY_NAME=Base

# --- Single-chain fallback (only used when CHAINS is empty) ------------------
#
# Two ways to supply RPC credentials:
#
#   A) Paste the whole URL with the key already in it:
#      RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/abc123def456
#
#   B) Use the {API_KEY} placeholder + RPC_API_KEY (cleaner, easier to rotate):
#      RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/{API_KEY}
#      RPC_API_KEY=abc123def456
#
# RPC_URL=https://bsc-dataseed.bnbchain.org
# RPC_API_KEY=
# FACTORY_ADDRESS=0x000310fa98E36191ec79de241d72C6CA093EAfD3,0x00306cEFc385c8767cA580913a3F88319a343FC0
# EXPLORER_TX=https://bscscan.com/tx/
# EXPLORER_ADDR=https://bscscan.com/address/
# EXPLORER_TOKEN=https://bscscan.com/token/

# --- Polling tuning ---------------------------------------------------------

# Default seconds between chain polls. Whitelisted users can change this at
# runtime with /interval (the new value is persisted to RUNTIME_CONFIG_FILE
# and survives restarts as long as the file does). The same interval applies
# to every chain monitor.
POLL_INTERVAL=180

# Bounds enforced on /interval. Stop users from hammering the RPC (too low)
# or letting the bot fall too far behind (too high).
MIN_POLL_INTERVAL=5
MAX_POLL_INTERVAL=3600

BLOCK_LOOKBACK=20
MAX_BLOCK_RANGE=1000

# --- Broadcast filter -------------------------------------------------------

# Skip broadcast alerts whose funding amount (in token units, after dividing
# by 10**decimals) is below this threshold. /check still shows everything;
# only the auto-broadcast is filtered. Set to 0 to disable. The filter only
# applies to DistributorCreated alerts; TimeSet alerts always go through.
# Applies globally (same threshold across all chains).
MIN_TOKEN_AMOUNT=1000

# --- TimeSet (claim window) tracking ----------------------------------------

# One-shot backfill on startup: scan this many blocks back from head for
# DistributorCreated events on EACH chain, so distributors deployed before
# the bot started are also watched for TimeSet. 0 = no backfill (only future
# events tracked). Note: applies per chain, so set conservatively if you
# monitor many chains.
BACKFILL_BLOCKS=0

# Cap on addresses sent in a single eth_getLogs call when polling TimeSet.
# Lower if your RPC rejects big address arrays.
LOGS_ADDRESS_CHUNK=100

# Extra chat ids that receive broadcast alerts on top of TELEGRAM_CHAT_ID.
# Whitelisted users opt a chat in by sending /activate from inside it.
SUBSCRIBERS_FILE=.subscribers.json

# --- Broadcast footer buttons -----------------------------------------------

# Two inline-button "cards" appended to every broadcast alert. Leave a TEXT
# or URL blank to hide that button.
FOOTER_BTN1_TEXT=Okx钱包 45%返佣开通联系@xxxXIAOC
FOOTER_BTN1_URL=https://t.me/xxxXIAOC
FOOTER_BTN2_TEXT=Boost数据看板
FOOTER_BTN2_URL=https://dune.com/0xxiaoc/okx-dex-boost

# --- State ------------------------------------------------------------------

# Directory where per-chain state files live:
#   <STATE_DIR>/.bot_state.<chain>.json     last processed block
#   <STATE_DIR>/.distributors.<chain>.json  distributor → token map
# On Railway, point this at a mounted volume (e.g. /data) so restarts don't
# replay or skip blocks.
STATE_DIR=.

LOG_LEVEL=INFO

# --- i18n -------------------------------------------------------------------

# Default language for users who haven't picked one yet. Supported: zh, en.
# Each user can override their own language at runtime via /lang or the menu.
# All broadcasts are sent bilingually (zh + en) regardless of this setting.
DEFAULT_LANG=zh

# Where to persist per-user language preferences. Point this at a Railway
# volume (e.g. /data/user_lang.json) to survive restarts.
USER_LANG_FILE=.user_lang.json

# Where to persist runtime config (current /interval value). Same advice —
# put it on a volume on Railway.
RUNTIME_CONFIG_FILE=.runtime_config.json
